# Copy to .streamlit/secrets.toml (never commit that file) or paste into
# Streamlit Community Cloud -> App settings -> Secrets.
# Use ONE of the two sources below. An uploaded file always wins for that session.

# --- Option A: read the live workbook from SharePoint (Microsoft Graph) -------
# Needs an Entra ID (Azure AD) app registration from IT with the application
# permission Sites.Selected (granted on this one site) or Sites.Read.All.
[sharepoint]
tenant_id = "00000000-0000-0000-0000-000000000000"
client_id = "00000000-0000-0000-0000-000000000000"
client_secret = "paste-the-secret-value"
# The link you get from Excel online / SharePoint ("Copy link" or the address bar)
file_url = "https://<tenant>.sharepoint.com/:x:/r/teams/<site>/_layouts/15/Doc.aspx?sourcedoc=%7B...%7D&file=<name>.xlsx"
# Optional: path inside the document library, if search can't find the file
# drive_path = "Folder/Subfolder/<name>.xlsx"

# --- Option B: read a synced copy on this computer ----------------------------
# Sync the SharePoint library with OneDrive, then point to the file.
# [local]
# path = "C:/Users/<you>/<Company>/<Site> - Documents/<name>.xlsx"
